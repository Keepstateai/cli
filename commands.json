{
  "$comment": "The machine-readable command manifest of ks. One row per verb the binary dispatches; manifest_test.go fails the build if this file and the source disagree in either direction. Downstream (keepstate.ai/docs/cli and its verb-count lint) renders FROM this file and must never hand-type a verb.",
  "schema": 1,
  "commands": [
    { "verb": "login", "aliases": [], "usage": "ks login [--ctl URL]", "summary": "sign in (browser device flow)", "status": "available", "surface": "client" },
