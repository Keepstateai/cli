{
 "comment": "Shared redaction vectors (session import). 'in' joins text and fakes (fixtures/import/fakes.json, joined at run time); 'want' is the redacted text; 'kinds' the redactions by kind. Written by fixtures/import/make_vectors.py from the reference reader; internal/importscan, the guest program and the client's vendored copy must all give these answers.",
 "rules_sha256_note": "the rules are internal/importscan/rules.json; the client vendors both files",
 "cases": [
  {
   "name": "anthropic key in a tool output",
   "in": [
    "ANTHROPIC_KEY seen: ",
    {
     "fake": "anthropic_key"
    },
    " end"
   ],
   "want": "ANTHROPIC_KEY seen: [redacted:anthropic_key] end",
   "kinds": {
    "anthropic_key": 1
   }
  },
  {
   "name": "openrouter key",
   "in": [
    "export OR=",
    {
     "fake": "openrouter_key"
    },
    "\n"
   ],
   "want": "export OR=[redacted:openrouter_key]\n",
   "kinds": {
    "openrouter_key": 1
   }
  },
  {
   "name": "openai key",
   "in": [
    "curl -H 'x: ",
    {
     "fake": "openai_key"
    },
    "'"
   ],
   "want": "curl -H 'x: [redacted:openai_key]'",
   "kinds": {
    "openai_key": 1
   }
  },
  {
   "name": "keepstate key",
   "in": [
    "session key ",
    {
     "fake": "keepstate_key"
    },
    " was shown"
   ],
   "want": "session key [redacted:keepstate_key] was shown",
   "kinds": {
    "keepstate_key": 1
   }
  },
  {
   "name": "github token",
   "in": [
    "remote https://x:",
    {
     "fake": "github_token"
    },
    "@github.com/o/r.git"
   ],
   "want": "remote https://x:[redacted:github_token]@github.com/o/r.git",
   "kinds": {
    "github_token": 1
   }
  },
  {
   "name": "aws access key",
   "in": [
    "aws_access_key_id is ",
    {
     "fake": "aws_access_key"
    },
    " in the profile"
   ],
   "want": "aws_access_key_id is [redacted:aws_access_key] in the profile",
   "kinds": {
    "aws_access_key": 1
   }
  },
  {
   "name": "google api key",
   "in": [
    "maps key ",
    {
     "fake": "google_api_key"
    },
    "."
   ],
   "want": "maps key [redacted:google_api_key].",
   "kinds": {
    "google_api_key": 1
   }
  },
  {
   "name": "telegram bot token",
   "in": [
    "bot ",
    {
     "fake": "telegram_bot_token"
    },
    " polls"
   ],
   "want": "bot [redacted:telegram_bot_token] polls",
   "kinds": {
    "telegram_bot_token": 1
   }
  },
  {
   "name": "slack token",
   "in": [
    "SLACK ",
    {
     "fake": "slack_token"
    }
   ],
   "want": "SLACK [redacted:slack_token]",
   "kinds": {
    "slack_token": 1
   }
  },
  {
   "name": "json web token",
   "in": [
    "jwt ",
    {
     "fake": "jwt"
    },
    " expires"
   ],
   "want": "jwt [redacted:jwt] expires",
   "kinds": {
    "jwt": 1
   }
  },
  {
   "name": "database url with a password",
   "in": [
    "DATABASE_URL points at ",
    {
     "fake": "connection_string"
    },
    " (the host)"
   ],
   "want": "DATABASE_URL points at [redacted:connection_string]db.internal:5432/app (the host)",
   "kinds": {
    "connection_string": 1
   }
  },
  {
   "name": "azure storage key",
   "in": [
    "DefaultEndpointsProtocol=https;",
    {
     "fake": "azure_account_key"
    },
    ";EndpointSuffix=core.windows.net"
   ],
   "want": "DefaultEndpointsProtocol=https;[redacted:azure_account_key];EndpointSuffix=core.windows.net",
   "kinds": {
    "azure_account_key": 1
   }
  },
  {
   "name": "bearer token in a header",
   "in": [
    "Authorization: ",
    {
     "fake": "bearer_token"
    }
   ],
   "want": "[redacted:authorization_header]",
   "kinds": {
    "authorization_header": 1
   }
  },
  {
   "name": "bearer token alone",
   "in": [
    "token is ",
    {
     "fake": "bearer_token"
    },
    "!"
   ],
   "want": "token is [redacted:bearer_token]!",
   "kinds": {
    "bearer_token": 1
   }
  },
  {
   "name": "private key block in a string",
   "in": [
    "key:\n",
    {
     "fake": "private_key_block"
    },
    "\nafter"
   ],
   "want": "key:\n[redacted:private_key_block]\nafter",
   "kinds": {
    "private_key_block": 1
   }
  },
  {
   "name": "assignment keeps the name",
   "in": [
    "# .env\n",
    {
     "fake": "assignment"
    },
    "\nDEBUG=true\n"
   ],
   "want": "# .env\nAPI_KEY=[redacted:assignment]\nDEBUG=true\n",
   "kinds": {
    "assignment": 1
   }
  },
  {
   "name": "assignment in json",
   "in": [
    "{\"client_secret\": \"",
    "wH4t3v3rs3cr3tv4lu3Z",
    "\", \"name\": \"x\"}"
   ],
   "want": "{\"client_secret\": \"[redacted:assignment]\", \"name\": \"x\"}",
   "kinds": {
    "assignment": 1
   }
  },
  {
   "name": "assignment in escaped json",
   "in": [
    "text: {\\\"password\\\": \\\"",
    "hunter2hunter2hunter2",
    "\\\"}"
   ],
   "want": "text: {\\\"password\\\": \\\"[redacted:assignment]\\\"}",
   "kinds": {
    "assignment": 1
   }
  },
  {
   "name": "two kinds on one line",
   "in": [
    {
     "fake": "github_token"
    },
    " and ",
    {
     "fake": "aws_access_key"
    }
   ],
   "want": "[redacted:github_token] and [redacted:aws_access_key]",
   "kinds": {
    "github_token": 1,
    "aws_access_key": 1
   }
  },
  {
   "name": "the same kind twice",
   "in": [
    {
     "fake": "anthropic_key"
    },
    " ",
    {
     "fake": "anthropic_key"
    }
   ],
   "want": "[redacted:anthropic_key] [redacted:anthropic_key]",
   "kinds": {
    "anthropic_key": 2
   }
  },
  {
   "name": "header with basic credentials",
   "in": [
    "authorization: Basic dXNlcjpwYXNzd29yZHZhbHVl"
   ],
   "want": "[redacted:authorization_header]",
   "kinds": {
    "authorization_header": 1
   }
  },
  {
   "name": "a sha256 digest is not a secret",
   "in": [
    "sha256 3b7e9d2a1c4f6e8b0a2d4c6e8f1a3b5d7c9e0f2a4b6d8c1e3f5a7b9d0c2e4f61 ok"
   ],
   "want": "sha256 3b7e9d2a1c4f6e8b0a2d4c6e8f1a3b5d7c9e0f2a4b6d8c1e3f5a7b9d0c2e4f61 ok",
   "kinds": {}
  },
  {
   "name": "a git sha is not a secret",
   "in": [
    "commit 5aed6be9c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6"
   ],
   "want": "commit 5aed6be9c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6",
   "kinds": {}
  },
  {
   "name": "a uuid is not a secret",
   "in": [
    "session 11111111-2222-4333-8444-555555555555"
   ],
   "want": "session 11111111-2222-4333-8444-555555555555",
   "kinds": {}
  },
  {
   "name": "task- words are not keys",
   "in": [
    "see task-1234567890123456789012345 and desk-ant-xxxxxxxxxxxxxxxxxxxxxxxx"
   ],
   "want": "see task-1234567890123456789012345 and desk-ant-xxxxxxxxxxxxxxxxxxxxxxxx",
   "kinds": {}
  },
  {
   "name": "a short value is not an assignment",
   "in": [
    "max_tokens=4096 and token=abc"
   ],
   "want": "max_tokens=4096 and token=abc",
   "kinds": {}
  },
  {
   "name": "a url without credentials",
   "in": [
    "postgres://db.internal:5432/app and user@example.com:8080"
   ],
   "want": "postgres://db.internal:5432/app and user@example.com:8080",
   "kinds": {}
  },
  {
   "name": "a version and a time",
   "in": [
    "claude 2.1.296 at 1700000000:12:45"
   ],
   "want": "claude 2.1.296 at 1700000000:12:45",
   "kinds": {}
  },
  {
   "name": "a base64 png header",
   "in": [
    "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk"
   ],
   "want": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk",
   "kinds": {}
  },
  {
   "name": "code that names a token",
   "in": [
    "tokenizer = AutoTokenizer; the token count is low"
   ],
   "want": "tokenizer = AutoTokenizer; the token count is low",
   "kinds": {}
  },
  {
   "name": "a marker already in place",
   "in": [
    "API_KEY=[redacted:assignment] and Bearer [redacted:bearer_token]"
   ],
   "want": "API_KEY=[redacted:assignment] and Bearer [redacted:bearer_token]",
   "kinds": {}
  }
 ]
}
