  {
   "name": "a confirm value cannot approve",
   "send": [
    {
     "jsonrpc": "2.0",
     "id": 1,
     "method": "initialize",
     "params": {
      "protocolVersion": "2025-11-25",
      "capabilities": {},
      "clientInfo": {
       "name": "vector",
       "version": "1"
      }
     }
    },
    {
     "jsonrpc": "2.0",
     "id": 2,
     "method": "tools/call",
     "params": {
      "name": "ks_agent_approve",
      "arguments": {
       "request": "req_1",
       "session": "ses_1",
       "confirm": "0123456789abcdef"
      }
     }
    }
   ],
   "expect": [
    {
     "id": 1,
     "result": {}
    },
