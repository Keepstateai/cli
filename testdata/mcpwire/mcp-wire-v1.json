  {
   "name": "a version it does not speak is refused with the ones it does",
   "send": [
    {
     "jsonrpc": "2.0",
     "id": 1,
     "method": "tools/list",
     "params": {
      "_meta": {
       "io.modelcontextprotocol/protocolVersion": "2099-01-01",
       "io.modelcontextprotocol/clientCapabilities": {}
