            }
           }
          }
         }
        }
       ]
      },
      "resultType": "complete",
      "ttlMs": {
       "$type": "number"
      },
      "cacheScope": {
       "$type": "string"
      },
      "_meta": {
       "io.modelcontextprotocol/serverInfo": {
        "name": "keepstate"
       }
      }
     }
    }
   ]
  },
  {
   "name": "a modern request without client capabilities is refused",
   "send": [
    {
     "jsonrpc": "2.0",
     "id": 1,
     "method": "tools/list",
     "params": {
      "_meta": {
       "io.modelcontextprotocol/protocolVersion": "2026-07-28"
      }
     }
    }
